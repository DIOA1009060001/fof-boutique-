<div class="card"><img src="./image/PHOTO-2026-10-31-00-46-50%202.jpg"><div class="info"><div class="name">Adidas Runfalcon</div><div class="price">12.000F</div><div class="sizes">37-45</div></div><button class="btn" onclick="window.open('https://wa.me/2250566407588?text=Runfalcon')">Commander</button></div>
