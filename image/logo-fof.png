<div class="card"><img src="./image/PHOTO-2026-10-31-00-49-30%202.jpg"><div class="info"><div class="name">Adidas Campus - Autre</div><div class="price">13.000F</div><div class="sizes">37-45</div></div><button class="btn" onclick="window.open('https://wa.me/2250566407588?text=Campus')">Commander</button></div>
